{
  "realm": "credits",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Can read, list and register clients and credits" },
      { "name": "ADMIN", "description": "Can also edit and archive clients and credits" }
    ]
  },
  "clients": [
    {
      "clientId": "credits-web",
      "name": "creditsAI web app",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost/*"],
      "webOrigins": ["http://localhost"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost/*"
      }
    }
  ],
  "users": [
    {
      "username": "user1",
      "enabled": true,
      "email": "user1@creditsai.local",
      "emailVerified": true,
      "firstName": "User",
      "lastName": "One",
      "credentials": [{ "type": "password", "value": "user1", "temporary": false }],
      "realmRoles": ["default-roles-credits", "USER"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@creditsai.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "One",
      "credentials": [{ "type": "password", "value": "admin1", "temporary": false }],
      "realmRoles": ["default-roles-credits", "USER", "ADMIN"]
    }
  ]
}
