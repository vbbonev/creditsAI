# Copy to .env and replace every value. .env is gitignored; never commit real secrets.
# Plain KEY=value lines, no quotes: the backend also reads this file as a .properties file
# when it runs from IntelliJ.

# Postgres superuser (only used by the container itself and the init script)
POSTGRES_PASSWORD=change-me-postgres

# Application database user "credits" (read by docker/postgres/init and by the backend)
CREDITS_DB_PASSWORD=change-me-credits

# Keycloak database user "keycloak"
KEYCLOAK_DB_PASSWORD=change-me-keycloak

# Keycloak admin console (http://localhost:8180), user "admin"
KEYCLOAK_ADMIN_PASSWORD=change-me-admin
