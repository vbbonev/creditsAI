{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(backend/mvnw -f backend/pom.xml *test*)",
      "Bash(backend/mvnw -f backend/pom.xml verify*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(jq empty *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(npm --prefix frontend test*)",
      "Bash(npm --prefix frontend run build*)",
      "Bash(npx --prefix frontend ng generate *)",
      "Bash(npx --prefix frontend ng g *)",
      "Bash(docker compose config*)"
    ],
    "ask": [
      "Bash(docker compose down*)",
      "Bash(npm install*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git commit*)",
      "Bash(rm -rf *)",
      "Bash(docker system prune*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-prompt.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh"
          }
        ]
      }
    ]
  }
}
